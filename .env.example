# Copy to .env and fill in. Never commit .env.
APP_ENV=development
CLINIC_NAME=Family Clinic

# Supabase: Project Settings > API. Use the secret key (server only), never the publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only the Supabase CLI uses this (supabase db push). The app never connects to Postgres directly.
SUPABASE_DB_PASSWORD=

# Generation: Claude Haiku via the Anthropic API
ANTHROPIC_API_KEY=

# Judgments: TypeSafe Jev. Leave the next two blank for the defaults.
TYPESAFE_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# Embeddings: Voyage AI
VOYAGE_API_KEY=
