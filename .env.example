# Copy to .env and fill in. Never commit .env.
APP_ENV=development
CLINIC_NAME=Family Clinic

# Supabase: Project Settings > API. Use the secret key (server only), never the publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only the Supabase CLI uses this (supabase db push). The app never connects to Postgres directly.
SUPABASE_DB_PASSWORD=

# Generation: Claude Haiku via the Anthropic API
ANTHROPIC_API_KEY=

# Judgments: TypeSafe Jev. Leave the next two blank for the defaults.
TYPESAFE_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# Embeddings: Voyage AI
VOYAGE_API_KEY=

# Email for class token links: Resend. EMAIL_FROM must be on a domain verified there,
# for example: Family Clinic Assistant <tokens@example.com>
RESEND_API_KEY=
EMAIL_FROM=
# Where emailed links point. Leave blank on Vercel (it knows its own address) and locally
# set it to the address you run on, for example http://127.0.0.1:8000
PUBLIC_BASE_URL=
